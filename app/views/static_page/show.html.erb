

<p><%= @response%></p>

<h1>The collection of <%= @response[:id] %> </h1>
<% @response[:media].each do |media| %>
    <img src="<%= media[:src][:medium]%>" alt="<%=media[:alt]%> ">
<% end %>   

<% if @response[:prev_page] %>
    <form action="<%=static_page_show_path%>">
        <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>" >
        <input type="hidden" name="collection_id" value="<%= @response[:id] %>">
        <%# <input type="hidden" name="page" value="<%= @response[:page] - 1 %>">
        <input type="submit" name="commit" value="prev">
    </form>
<% end %> 
<% if @response[:next_page] %>
    <form action="<%=static_page_show_path%>">
        <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>" >
        <input type="hidden" name="collection_id" value="<%= @response[:id] %>">
        <input type="hidden" name="increment_page" value="<%= @response[:next_page] %>">
        <input type="submit" name="commit" value="next">
    </form>
<% end %>
